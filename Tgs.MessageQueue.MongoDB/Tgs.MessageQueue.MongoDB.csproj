<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>10.0</LangVersion>
		<Version>2.3.1</Version>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-message-queue.git</RepositoryUrl>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-message-queue</PackageProjectUrl>
		<PackageTags>tgs</PackageTags>
		<Authors>Raypro</Authors>
		<RootNamespace>Tgs.MessageQueue.MongoDB</RootNamespace>
		<PackageId>Tgs.MessageQueue.MongoDB</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[5.0.0, 6.0)" Condition="'$(TargetFramework)' == 'net5.0'" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="7.0.0" Condition="'$(TargetFramework)' == 'net6.0'" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[5.0.0, 6.0)" Condition="'$(TargetFramework)' == 'net5.0'" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0" Condition="'$(TargetFramework)' == 'net6.0'" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.4.27">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MongoDB.Driver" Version="2.18.0" />
		<PackageReference Include="MongoDB.Messaging" Version="2.0.0.28" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Tgs.MessageQueue.MongoDB.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tgs.MessageQueue\Tgs.MessageQueue.csproj" />
	</ItemGroup>

</Project>
